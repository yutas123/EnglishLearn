generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Album {
  id          String   @id @default(cuid())
  artistName  String
  albumTitle  String
  releaseId   String? // MusicBrainz Release ID
  coverArtUrl String?
  geniusUrl   String?
  createdAt   DateTime @default(now())
  tracks      Track[]

  @@unique([artistName, albumTitle])
}

model Track {
  id               String            @id @default(cuid())
  albumId          String
  album            Album             @relation(fields: [albumId], references: [id])
  trackNo          Int
  title            String
  analysis         String? // 楽曲解説（generateSongAnalysis の出力）
  translations     Translation[]
  highlights       Highlight[]
  vocabEntries     VocabEntry[]
  vocabOccurrences VocabOccurrence[]
  spanExplanations SpanExplanation[]
  createdAt        DateTime          @default(now())
}

model Translation {
  id          String  @id @default(cuid())
  trackId     String
  track       Track   @relation(fields: [trackId], references: [id])
  lineIndex   Int // 行番号（表示順）
  original    String
  translation String
  explanation String? // LLMによる自動解説（倒置・イディオム等）
  hardSpans   Json? // [{ "start": Int, "end": Int }] 難所ハイライト（新規処理分のみ）
}

model VocabEntry {
  id              String    @id @default(cuid())
  term            String // 単語=lemma / イディオム=軽く整形のみ、小文字化
  surfaceForm     String // 選択時の原文表示用
  isPhrase        Boolean   @default(false)
  meaning         String
  partOfSpeech    String?
  cefr            String? // A1〜C2、null許容
  explanation     String? // 「詳しく!」で生成された解説文（登録時に一緒に保存された場合のみ）
  sourceTrackId   String
  sourceTrack     Track     @relation(fields: [sourceTrackId], references: [id])
  sourceLineIndex Int
  createdAt       DateTime  @default(now())

  // SM-2簡易SRS
  easeFactor     Float     @default(2.5)
  intervalDays   Int       @default(0)
  repetitions    Int       @default(0)
  nextReviewAt   DateTime  @default(now())
  lastReviewedAt DateTime?

  occurrences VocabOccurrence[]

  @@unique([term, isPhrase])
  @@index([nextReviewAt])
}

model VocabOccurrence {
  id           String     @id @default(cuid())
  vocabEntryId String
  vocabEntry   VocabEntry @relation(fields: [vocabEntryId], references: [id])
  trackId      String
  track        Track      @relation(fields: [trackId], references: [id])
  lineIndex    Int
  createdAt    DateTime   @default(now())

  @@unique([vocabEntryId, trackId, lineIndex])
}

model SpanExplanation {
  id           String   @id @default(cuid())
  trackId      String
  track        Track    @relation(fields: [trackId], references: [id])
  lineIndex    Int
  selectedText String
  explanation  String
  createdAt    DateTime @default(now())

  @@unique([trackId, lineIndex, selectedText])
}

model Highlight {
  id          String   @id @default(cuid())
  trackId     String
  track       Track    @relation(fields: [trackId], references: [id])
  lineIndex   Int
  startOffset Int // original文字列内の開始位置
  endOffset   Int
  createdAt   DateTime @default(now())
}

model Job {
  id              String   @id @default(cuid())
  type            String // "album" 固定でよい
  artistName      String
  albumName       String
  status          String // pending / running / done / error
  progressLog     String? // 直近の進捗メッセージ（任意）
  errorMessage    String?
  albumId         String? // 完了時にVercelのrevalidatePathへ渡すために保持
  geniusAlbumId   String? // Geniusから手動追加した場合のGeniusアルバムID（MusicBrainzを経由しない）
  totalTracks     Int? // アルバムの総曲数（判明時に設定）
  completedTracks Int      @default(0) // 処理完了した曲数
  costUsd         Float    @default(0) // OpenAI API利用の累計コスト（ドル）
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
