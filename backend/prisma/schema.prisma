generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Album {
  id          String   @id @default(cuid())
  artistName  String
  albumTitle  String
  releaseId   String? // MusicBrainz Release ID
  coverArtUrl String?
  geniusUrl   String?
  releaseYear Int? // リリース年（表示用。取得できなかった旧データはnull）
  releaseDate String? // リリース日 YYYY-MM-DD（月日が不明なら YYYY / YYYY-MM。同年内の並び順用）
  isFavorite  Boolean  @default(false) // お気に入り（一覧上部にピン留め）
  createdAt   DateTime @default(now())
  tracks      Track[]

  @@unique([artistName, albumTitle])
}

model Track {
  id                String             @id @default(cuid())
  albumId           String
  album             Album              @relation(fields: [albumId], references: [id])
  trackNo           Int
  title             String
  analysis          String? // 楽曲解説（generateSongAnalysis の出力）
  youtubeVideoId    String? // 書き取りモードで再生するYouTube動画ID
  translations      Translation[]
  highlights        Highlight[]
  vocabEntries      VocabEntry[]
  vocabOccurrences  VocabOccurrence[]
  spanExplanations  SpanExplanation[]
  listeningMarks    ListeningMark[]
  dictationAttempts DictationAttempt[]
  lineNotes         TrackLineNote[]
  createdAt         DateTime           @default(now())
}

model Translation {
  id           String  @id @default(cuid())
  trackId      String
  track        Track   @relation(fields: [trackId], references: [id])
  lineIndex    Int // 行番号（表示順）
  original     String
  translation  String
  explanation  String? // LLMによる自動解説（倒置・イディオム等）
  hardSpans    Json? // [{ "start": Int, "end": Int }] 難所ハイライト（新規処理分のみ）
  sectionLabel String? // Geniusのセクション見出し原文（例: "Verse 1: Paul McCartney & John Lennon"、新規処理分のみ）
}

model VocabEntry {
  id              String   @id @default(cuid())
  term            String // 単語=lemma / イディオム=軽く整形のみ、小文字化
  surfaceForm     String // 選択時の原文表示用
  isPhrase        Boolean  @default(false)
  meaning         String
  partOfSpeech    String?
  cefr            String? // A1〜C2、null許容
  ipa             String? // 発音記号（IPA）。単語のみ、イディオムはnull
  explanation     String? // 「詳しく!」で生成された解説文（登録時に一緒に保存された場合のみ）
  sourceTrackId   String
  sourceTrack     Track    @relation(fields: [sourceTrackId], references: [id])
  sourceLineIndex Int
  createdAt       DateTime @default(now())

  // SM-2簡易SRS
  easeFactor     Float     @default(2.5)
  intervalDays   Int       @default(0)
  repetitions    Int       @default(0)
  nextReviewAt   DateTime  @default(now())
  lastReviewedAt DateTime?

  occurrences VocabOccurrence[]

  @@unique([term, isPhrase])
  @@index([nextReviewAt])
}

model VocabOccurrence {
  id           String     @id @default(cuid())
  vocabEntryId String
  vocabEntry   VocabEntry @relation(fields: [vocabEntryId], references: [id])
  trackId      String
  track        Track      @relation(fields: [trackId], references: [id])
  lineIndex    Int
  createdAt    DateTime   @default(now())

  @@unique([vocabEntryId, trackId, lineIndex])
}

model SpanExplanation {
  id           String   @id @default(cuid())
  trackId      String
  track        Track    @relation(fields: [trackId], references: [id])
  lineIndex    Int
  selectedText String
  explanation  String
  createdAt    DateTime @default(now())

  @@unique([trackId, lineIndex, selectedText])
}

model ListeningMark {
  id          String   @id @default(cuid())
  trackId     String
  track       Track    @relation(fields: [trackId], references: [id])
  lineIndex   Int // 「聞き取れなかった」とマークした行
  explanation String? // AIによる音声変化パターン解説（オンデマンド生成、キャッシュ）
  createdAt   DateTime @default(now())

  @@unique([trackId, lineIndex])
}

model DictationAttempt {
  id         String   @id @default(cuid())
  trackId    String
  track      Track    @relation(fields: [trackId], references: [id])
  text       String // ユーザーが書いた書き取りテキスト（?? は聞き取れなかった印）
  scopeLines Json? // 一部の行だけ再挑戦した場合の対象lineIndex配列（全体なら null）
  accuracy   Float // 一致語数 / 採点対象語数（0〜1）
  totalWords Int // 採点対象語数
  gapCount   Int // 「??」にした語数
  result     Json // evaluateDictation の結果（行ごとの語単位判定。AI解説は lines[].explanation に保存）
  createdAt  DateTime @default(now())

  @@index([trackId, createdAt])
}

model TrackLineNote {
  id        String   @id @default(cuid())
  trackId   String
  track     Track    @relation(fields: [trackId], references: [id])
  lineIndex Int
  note      String // 書き取りで「なぜ聴き取れなかったか」の自分用メモ
  updatedAt DateTime @updatedAt

  @@unique([trackId, lineIndex])
}

model Highlight {
  id          String   @id @default(cuid())
  trackId     String
  track       Track    @relation(fields: [trackId], references: [id])
  lineIndex   Int
  startOffset Int // original文字列内の開始位置
  endOffset   Int
  createdAt   DateTime @default(now())
}

model Job {
  id              String   @id @default(cuid())
  type            String // "album" 固定でよい
  artistName      String
  albumName       String
  status          String // pending / running / done / error
  progressLog     String? // 直近の進捗メッセージ（任意）
  errorMessage    String?
  albumId         String? // 完了時にVercelのrevalidatePathへ渡すために保持
  geniusAlbumId   String? // Geniusから手動追加した場合のGeniusアルバムID（MusicBrainzを経由しない）
  totalTracks     Int? // アルバムの総曲数（判明時に設定）
  completedTracks Int      @default(0) // 処理完了した曲数
  costUsd         Float    @default(0) // OpenAI API利用の累計コスト（ドル）
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
